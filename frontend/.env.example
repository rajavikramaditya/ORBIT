# ORBIT Frontend — Local Development Environment
# Public API origin used at build time. For production set this to the live API URL
# before running `npm run build` (e.g. https://api.your-domain.com).
REACT_APP_BACKEND_URL=http://localhost:8001

# Native Google OAuth 2.0 (set to true to enable the "Continue with Google" button)
# In production (Vercel): set to true
REACT_APP_ENABLE_GOOGLE_LOGIN=true
