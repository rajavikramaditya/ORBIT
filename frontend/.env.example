# ORBIT Frontend — Local Development Environment
# Public API origin used at build time. For production set this to the live API URL
# before running `npm run build` (e.g. https://api.your-domain.com).
REACT_APP_BACKEND_URL=http://localhost:8001

# Google sign-in routes through the Emergent auth service and only works in
# Emergent-hosted environments. Leave unset (hidden) for local/production until
# real Google OAuth is wired up.
# REACT_APP_ENABLE_GOOGLE_LOGIN=true
