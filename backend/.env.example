# ORBIT Backend — Local Development Environment
# Copy to .env and fill in values. Do NOT commit the real .env file.
# Production values are documented in DEPLOYMENT.md — never reuse these local defaults.

# ---- Core (required for local dev) ----
# Environment: development | production.
# In production: set ORBIT_ENV=production and a dedicated DB_NAME (not orbit_dev).
# Demo tenants (Taj/Leela) are only seeded in development/demo/test.
ORBIT_ENV=development
MONGO_URL=mongodb://localhost:27017
DB_NAME=orbit_dev
JWT_SECRET=local-dev-jwt-secret-change-in-production
WEBHOOK_SECRET=orbit_whsec_3a9f7c2e1b8d6045a3c9e7f1b2d4a6c8
FRONTEND_URL=http://localhost:3000
# Optional comma-separated extra origins. Localhost is added automatically in development only.
# CORS_ORIGINS=http://localhost:3000
# Set true in production (HTTPS). false allows auth cookies on http://localhost.
COOKIE_SECURE=false

# ---- Seed accounts (required — used by seed.py on startup) ----
ADMIN_EMAIL=admin@orbit.ai
ADMIN_PASSWORD=OrbitAdmin@2026
DEMO_OWNER_EMAIL=owner@tajpalace.in
DEMO_OWNER_PASSWORD=Hotel@2026

# ---- Provider credentials (leave empty for local dev — mock/demo mode works without them) ----
ELEVENLABS_API_KEY=
ELEVENLABS_WEBHOOK_SECRET=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_ACCOUNT_SID=
EXOTEL_SUBDOMAIN=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
